# ── Python ──────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
*.egg
.eggs/
build/
dist/
.ipynb_checkpoints/
.venv/
venv/
env/

# ── Trained models / RL checkpoints (results, regenerate by training) ──
tmp/
models/
runs/
*_torch_ppo
*.pt
*.pth
*.pkl
*.zip

# ── uv / build ── (uv.lock IS committed for reproducibility)
.venv*/

# ── Ephemeris cache (bulk-fetched from JPL Horizons at run time; never commit) ──
.ephem_cache/
*.npz

# ── Data & results artifacts (no blobs in git; generate at build/run time) ──
*.csv
plots/
*.png
*.jpg
*.gif
*.mp4

# ── README figures: the sanctioned small-figure exception to the no-blobs
#    rule. Regenerable by scripts/viz_readme.py; kept small (< ~250 KB each)
#    so the public README renders on GitHub. Re-include past the blob globs. ──
!docs/media/*.png
!docs/media/*.gif
!docs/media/*.svg

# ── Report source blobs (converted copies live in docs/*.md) ──
docs/reports-src/

# ── Editor / OS cruft ──
.~lock.*#
*.swp
.DS_Store
.rnd/
